generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id              String         @id @default(cuid())
  balance         Decimal        @db.Decimal(18, 2)
  baseRiskPct     Decimal        @db.Decimal(5, 2)
  riskLimitPct    Decimal        @default(3.00) @db.Decimal(5, 2) // потолок суммарного риска открытых позиций, % от баланса
  feeRatePct      Decimal        @db.Decimal(6, 4) // напр. 0.0600 = 0.06%
  defaultLeverage Decimal        @default(5) @db.Decimal(5, 2) // плечо по умолчанию для новых сделок
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  // Владелец счёта. Необязательный, пока существующий счёт не передан своему
  // пользователю; уникальный — у пользователя ровно один торговый счёт.
  userId          String?        @unique
  user            User?          @relation(fields: [userId], references: [id])
  trades          Trade[]
  balanceEvents   BalanceEvent[]
}

model BalanceEvent {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])
  type           String // "deposit" | "withdrawal" | "trade_settlement" | "manual_adjustment"
  amount         Decimal  @db.Decimal(18, 2) // знак: + пополнение/прибыль, - снятие/убыток
  relatedTradeId String?
  note           String?
  createdAt      DateTime @default(now())

  @@index([accountId])
}

model Trade {
  id             String    @id @default(cuid())
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id])
  pair           String
  direction      Int // 1 = long, -1 = short
  entryPrice     Decimal   @db.Decimal(18, 8)
  stopLoss       Decimal   @db.Decimal(18, 8)
  riskPct        Decimal   @db.Decimal(5, 2)
  depositAtEntry Decimal   @db.Decimal(18, 2) // снапшот баланса на момент открытия
  feeRateAtEntry Decimal   @db.Decimal(6, 4) // снапшот ставки комиссии
  riskAmount     Decimal   @db.Decimal(18, 2) // = depositAtEntry * riskPct / 100
  positionSize   Decimal   @db.Decimal(18, 2) // номинал позиции; на риск плечо не влияет
  leverage       Decimal   @default(5) @db.Decimal(5, 2) // маржа = positionSize / leverage
  tvLink         String?
  status         String    @default("open") // "open" | "closed"
  createdAt      DateTime  @default(now())
  closedAt       DateTime?

  // заполняется при закрытии, null пока сделка открыта
  grossPnL           Decimal? @db.Decimal(18, 2)
  totalFees          Decimal? @db.Decimal(18, 2)
  netPnL             Decimal? @db.Decimal(18, 2)
  netPnlPctOfDeposit Decimal? @db.Decimal(8, 4)
  realizedAvgExit    Decimal? @db.Decimal(18, 8)
  realizedRR         Decimal? @db.Decimal(8, 4)

  fixes Fix[]

  @@index([accountId, status])
}

model Fix {
  id        String   @id @default(cuid())
  tradeId   String
  trade     Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  price     Decimal  @db.Decimal(18, 8)
  sizePct   Decimal  @db.Decimal(5, 2) // % от исходного объёма позиции
  type      String // "manual" | "stop"
  createdAt DateTime @default(now())

  @@index([tradeId])
}

// Журнал попыток входа: на нём держатся ограничение перебора и сигналы.
// Не привязан к аккаунту — попытка случается до того, как известно, кто это.

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  success   Boolean
  country   String?
  city      String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([createdAt])
}

// Отправленные сигналы безопасности: не дают слать один и тот же сигнал на
// каждую попытку и остаются журналом того, что происходило. Ключ включает окно
// времени и уникален — дедупликация атомарна на уровне базы, параллельные
// запросы не могут отправить дубль.

model SecurityAlert {
  id        String   @id @default(cuid())
  key       String   @unique // "ip-lockout:1.2.3.4:<окно>", "mass-failures:<окно>"
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model User {
  id                  String        @id
  name                String
  email               String
  emailVerified       Boolean       @default(false)
  image               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  role                String?
  banned              Boolean?      @default(false)
  banReason           String?
  banExpires          DateTime?
  canParseScreenshots Boolean?      @default(false)
  sessions            Session[]
  authaccounts        AuthAccount[]
  tradingAccount      Account?
  invitesCreated      Invite[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("authAccount")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// Приглашение по ссылке. Хранится не сам токен из ссылки, а его SHA-256:
// прочитав базу, рабочую ссылку не получить. Одноразовое, живёт 7 дней.
model Invite {
  id          String    @id @default(cuid())
  email       String // на эту почту и только на неё можно завести учётку
  tokenHash   String    @unique
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?

  @@index([email])
}
