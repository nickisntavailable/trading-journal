# Neon connection string (Vercel-интеграция подставляет его автоматически)
DATABASE_URL=

# Старый общий пароль. Нужен один раз — подтвердить создание владельца на /setup.
# После этого переменную можно удалить.
APP_PASSWORD=

# Бот Telegram (только прод): токен от @BotFather и секрет webhook —
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Необязательно: слать сигналы безопасности в этот чат, а не админам
TELEGRAM_CHAT_ID=

# Better Auth: секрет для подписи сессий и адрес сайта (на превью не нужен).
# Секрет: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Почта владельца: ему достанутся существующие сделки и роль admin
OWNER_EMAIL=
