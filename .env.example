# Neon connection string (Vercel-интеграция подставляет его автоматически)
DATABASE_URL=

# Серверный ключ Anthropic — никогда не передаётся на клиент
ANTHROPIC_API_KEY=

# Модель для разбора скриншотов; по умолчанию claude-haiku-4-5
# Точнее, но дороже и медленнее: claude-opus-5
VISION_MODEL=

# Пароль для входа (MVP-заглушка вместо полноценного auth)
APP_PASSWORD=

# Сигналы безопасности в Telegram (необязательно): токен от @BotFather и id чата
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Better Auth: секрет для подписи сессий (openssl rand -base64 32) и адрес сайта
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Email владельца: ему достанутся существующие данные и роль admin
OWNER_EMAIL=
